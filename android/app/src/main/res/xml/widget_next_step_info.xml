<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1: the next step of today's quests; wider adds a tick button. Also offered on the lock screen where the phone supports lock screen widgets. See NextStepWidgetProvider. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="200dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_next_step"
    android:previewLayout="@layout/widget_next_step"
    android:description="@string/widget_next_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard">
</appwidget-provider>
