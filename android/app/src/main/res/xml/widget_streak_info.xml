<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1: the streak flame. Also offered on the lock screen where the phone supports lock screen widgets. See StreakWidgetProvider. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="200dp"
    android:maxResizeHeight="200dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_streak"
    android:previewLayout="@layout/widget_streak"
    android:description="@string/widget_streak_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard">
</appwidget-provider>
